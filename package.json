{
  "name": "honeybee",
  "version": "4.2.0",
  "description": "A tiny desktop widget that shows what your Claude Code and Codex agents are doing, the moment one needs you, and how much of your usage limits is left.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-unit.js",
    "test:electron": "electron test/electron-smoke.js",
    "screens": "electron test/electron-smoke.js --screens test-results/screenshots",
    "icons": "electron scripts/make-icons.js",
    "promo": "electron promo/render.js",
    "build": "electron-builder --publish=never",
    "build:win": "electron-builder --win --publish=never",
    "build:mac": "electron-builder --mac --publish=never",
    "build:linux": "electron-builder --linux --publish=never",
    "pack:dir": "electron-builder --dir --publish=never"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "usage",
    "rate-limits",
    "widget",
    "electron"
  ],
  "homepage": "https://github.com/banuca/honeybee",
  "repository": {
    "type": "git",
    "url": "https://github.com/banuca/honeybee.git"
  },
  "author": "Bhanuka Kirinde (banuca) <banuca@users.noreply.github.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "com.banuca.honeybee",
    "productName": "honeybee",
    "copyright": "Copyright © 2026 Bhanuka Kirinde",
    "publish": null,
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "package.json",
      "LICENSE",
      "src/**/*",
      "assets/tray/**/*",
      "assets/icon.png",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon-full.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "honeybee",
      "artifactName": "honeybee-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "honeybee-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSUIElement": false
      },
      "artifactName": "honeybee-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "honeybee-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development",
      "synopsis": "Watch your coding agents and your usage limits",
      "maintainer": "Bhanuka Kirinde <banuca@users.noreply.github.com>",
      "artifactName": "honeybee-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "honeybee",
          "Comment": "Watch your Claude Code and Codex agents and your usage limits",
          "Categories": "Development;Utility;",
          "StartupWMClass": "honeybee"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
